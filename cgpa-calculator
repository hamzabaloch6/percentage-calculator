<div class="semester">

<div class="semester-title">Semester 2</div>

<label>Semester GPA</label>

<input
class="gpa"
type="number"
inputmode="decimal"
min="0"
max="4"
step="0.01"
placeholder="e.g. 3.70"
>

<label>Credit Hours</label>

