<script>

function addSemester(){

const container=document.getElementById("semesters");

const button=container.querySelector(".add-btn");

const count=document.querySelectorAll(".semester").length+1;

const div=document.createElement("div");

div.className="semester";

div.innerHTML=`
<div class="semester-title">Semester ${count}</div>

<label>Semester GPA</label>

<input
class="gpa"
type="number"
inputmode="decimal"
min="0"
max="4"
step="0.01"
placeholder="e.g. 3.50"
>

<label>Credit Hours</label>

<input
class="credit"
type="number"
inputmode="decimal"
min="1"
step="0.5"
placeholder="e.g. 15"
>
`;

container.insertBefore(div,button);

}

function calculateCGPA(){

const gpas=document.querySelectorAll(".gpa");
const credits=document.querySelectorAll(".credit");

let totalPoints=0;
let totalCredits=0;

for(let i=0;i<gpas.length;i++){

let gpa=parseFloat(gpas[i].value);
let credit=parseFloat(credits[i].value);

if(isNaN(gpa)||gpa<0||gpa>4){

const result=document.getElementById("result");

result.innerHTML="Please enter a valid GPA between 0 and 4.";

result.classList.add("show");

return;
}

if(isNaN(credit)||credit<=0){

const result=document.getElementById("result");

result.innerHTML="Please enter valid credit hours.";

result.classList.add("show");

return;
}

totalPoints+=gpa*credit;
totalCredits+=credit;

}

if(totalCredits===0){

const result=document.getElementById("result");

result.innerHTML="Please enter your semester details.";

result.classList.add("show");

return;
}

const cgpa=totalPoints/totalCredits;

const result=document.getElementById("result");

result.innerHTML=
"<strong>Your CGPA: "+cgpa.toFixed(2)+"</strong><br>"+
"Total Credit Hours: "+totalCredits.toFixed(1);

result.classList.add("show");

}

</script>

