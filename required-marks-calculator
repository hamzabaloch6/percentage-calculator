<script>
function calculateRequired(){

let target=parseFloat(document.getElementById("target").value);
let total=parseFloat(document.getElementById("total").value);
let result=document.getElementById("result");

if(isNaN(target)||isNaN(total)||total<=0||target<=0||target>100){

result.innerHTML=
"Please enter valid values. Desired percentage must be between 1% and 100%, and total marks must be greater than 0.";

result.classList.add("show");
return;
}

let required=Math.ceil((total*target)/100);

result.innerHTML=
"Desired Percentage: <strong>"+target.toFixed(2)+"%</strong><br>"+
"Total Marks: <strong>"+total+"</strong><br><br>"+
"You need at least <strong>"+required+" marks</strong> to achieve "+
"<strong>"+target.toFixed(2)+"%</strong>.";

result.classList.add("show");
}
</script>

